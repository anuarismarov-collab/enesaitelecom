---
// Root page: normally the Cloudflare Worker redirects "/" to the visitor's language (Accept-Language).
// This static page is the fallback (previews, other hosts): it sends everyone to English and offers the other languages.
const origin = Astro.site!.origin;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>ENESAI TELECOM FZCO</title>
  <meta http-equiv="refresh" content="0; url=/en/" />
  <link rel="canonical" href={origin + '/en/'} />
  <link rel="alternate" hreflang="en" href={origin + '/en/'} /><link rel="alternate" hreflang="ru" href={origin + '/ru/'} /><link rel="alternate" hreflang="ar" href={origin + '/ar/'} />
  <link rel="alternate" hreflang="x-default" href={origin + '/en/'} />
  <link rel="icon" href="/brand/favicon.png" type="image/png" />
  <link rel="stylesheet" href="/root.css" />
</head>
<body class="rootpage">
  <main><img src="/brand/logo-full.webp" width="220" height="148" alt="ENESAI TELECOM FZCO" />
    <p><a href="/en/">English</a> · <a href="/ru/">Русский</a> · <a href="/ar/">العربية</a></p></main>
</body>
</html>
