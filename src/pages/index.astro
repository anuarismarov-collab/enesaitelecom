---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, categories, products, brands, productsOf, slugify, waLink } from '../lib/data';

const featured = products.filter((p) => p.featured).slice(0, 8);
const deals = products.filter((p) => p.was && p.stock !== 'out').slice(0, 4);
const heroIds = ['ps5-slim-disc', 'macbook-air-m3', 'iphone-15-pro', 'dyson-v15'];
const hero = heroIds.map((id) => products.find((p) => p.id === id)!);
const marquee = ['Apple', 'Samsung', 'PlayStation', 'DJI', 'GoPro', 'Insta360', 'Garmin', 'Dyson'];
---
<Base title={`${site.name} — iPhone, PS5, MacBook, DJI, Dyson & more`} description="Original Apple, Samsung, PlayStation, DJI, GoPro, Garmin and Dyson products at honest prices. Retail and wholesale. Order via WhatsApp.">
  <section class="hero">
    <div class="wrap hero-in">
      <div>
        <span class="tag">100% original · Retail &amp; wholesale</span>
        <h1>Real tech.<br /><mark>Real deals.</mark></h1>
        <p class="lead">iPhone, MacBook, PlayStation, DJI, Garmin, Dyson and more — sealed, genuine and ready to ship across the UAE. Message us for the best price.</p>
        <div class="hero-btns"><a href="/shop/" class="btn lg">Shop now</a><a href="/wholesale/" class="btn lg ghost">Wholesale prices</a></div>
        <ul class="perks"><li>Official warranty</li><li>Same-day dispatch</li><li>Cash, card &amp; bank transfer</li></ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        {hero.map((p) => <div class={`hcell tone-${p.tone}`}><Art art={p.art} /></div>)}
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true"><div class="track">
    {[...marquee, ...marquee].map((m, i) => <><span>{m}</span><span>✦</span></>)}
  </div></div>

  <section class="sec wrap">
    <div class="head"><span class="eyebrow">Shop by category</span><h2>Find what you need</h2></div>
    <div class="ctiles">
      {categories.map((c) => (
        <a class={`ctile tone-${c.tone}`} href={`/category/${c.id}/`}>
          <Art art={c.art} /><div><h3>{c.name}</h3><small>{productsOf(c.id).length} products · {c.blurb}</small></div><span class="go" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sec tight wrap">
    <div class="head"><span class="eyebrow">Popular right now</span><h2>Customer favourites</h2></div>
    <div class="pgrid">{featured.map((p) => <ProductCard p={p} />)}</div>
    <p class="more"><a class="btn ghost" href="/shop/">View all products →</a></p>
  </section>

  <section class="deals">
    <div class="wrap"><div class="head"><span class="eyebrow">Limited offers</span><h2>Deals of the week</h2></div>
      <div class="pgrid">{deals.map((p) => <ProductCard p={p} />)}</div></div>
  </section>

  <section class="sec wrap">
    <div class="head"><span class="eyebrow">Brands we carry</span><h2>Authorised, trusted names</h2></div>
    <div class="brands">{brands.map((b) => <a class="brand" href={`/brand/${slugify(b)}/`}>{b}</a>)}</div>
    <p class="fine">Brand names shown as text. Official logos and authorisation letters will be added once supplied by the company.</p>
  </section>

  <section class="wholesale">
    <div class="wrap ws-in">
      <div>
        <span class="eyebrow">For shops &amp; businesses</span>
        <h2>Wholesale &amp; bulk orders</h2>
        <p>Stocking a shop or equipping an office? Get trade prices, bulk discounts and fast dispatch on phones, laptops, consoles, printers and appliances.</p>
        <ul class="ticks"><li>Trade price list on request</li><li>Volume pricing from 5 units</li><li>Export &amp; shipping documents handled</li><li>Dedicated account manager</li></ul>
        <a class="btn lg" href="/wholesale/">Request trade prices</a>
      </div>
      <div class="ws-card"><div class="big">5+</div><small>units for wholesale pricing</small><div class="big">24h</div><small>quote turnaround</small><div class="big">100%</div><small>original &amp; sealed</small></div>
    </div>
  </section>

  <section class="sec wrap">
    <div class="head"><span class="eyebrow">Why buy from us</span><h2>Shop with confidence</h2></div>
    <div class="why4">
      <div class="b"><h3>Genuine products</h3><p>Sealed, original stock with full manufacturer warranty.</p></div>
      <div class="b"><h3>Honest prices</h3><p>Competitive pricing with no hidden charges.</p></div>
      <div class="b dark"><h3>Fast delivery</h3><p>Same-day dispatch in the UAE, worldwide shipping on request.</p></div>
      <div class="b"><h3>Real support</h3><p>Talk to a person on WhatsApp, phone or in our shop.</p></div>
    </div>
  </section>

  <section class="sec wrap faq-sec">
    <div><span class="eyebrow">Help</span><h2>Quick answers</h2></div>
    <div class="faq">
      <details><summary>Are the products original?</summary><p>Yes. All products are brand new, sealed and carry the warranty shown on the product page.</p></details>
      <details><summary>How do I order?</summary><p>Tap “Add to enquiry” on the products you like, then send the list on WhatsApp. We confirm stock and price, and arrange payment and delivery.</p></details>
      <details><summary>Do you offer wholesale prices?</summary><p>Yes — for 5 or more units, or for registered businesses. Use the wholesale page.</p></details>
      <details><summary>What is your return policy?</summary><p>Faulty items are replaced under warranty. Full return terms will be confirmed by the company (sample text).</p></details>
    </div>
  </section>

  <section class="sec tight wrap">
    <div class="split">
      <div><span class="eyebrow">Contact</span><h2>Visit us or message us</h2>
        <ul class="cinfo"><li><b>Address</b>{site.address}</li><li><b>Phone</b><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li><li><b>Hours</b>{site.hours}</li></ul>
        <a class="btn ghost" href={waLink(`Hello ${site.name}`)} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a></div>
      <div><ContactForm intro="I have a question:" /></div>
    </div>
  </section>
</Base>
