---
import Base from '../layouts/Base.astro';
import { useT, lp } from '../i18n/dict';
const T = useT('en');
---
<Base lang="en" title={T.notFound.title} description={T.notFound.text} noindex>
  <section class="wrap page notfound"><h1>404</h1><p class="muted">{T.notFound.text}</p><a class="btn lg" href={lp('en')}>{T.notFound.cta}</a></section>
</Base>
