---
import Base from '../layouts/Base.astro';
import { products, credits } from '../lib/data';
const name = (id: string) => products.find((p) => p.id === id)?.name ?? id;
const free = credits.filter((c) => c.kind !== 'brand');
const brand = credits.filter((c) => c.kind === 'brand');
---
<Base title="Image credits" description="Credits for the temporary product images used on this website.">
  <div class="wrap page prose">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span>Image credits</span></nav>
    <h1 class="h1m">Image credits</h1>
    <p>The product images on this website are temporary. They will be replaced with the company's own photos or supplier-approved images.</p>

    <h2>Manufacturer images</h2>
    <p>These images belong to the brands named below and come from each manufacturer's official product page. All trademarks and images are © their respective owners; this website is not affiliated with them.</p>
    <ul>
      {brand.map((c) => <li><b>{name(c.id)}</b> — © {c.author}, <a href={c.source} target="_blank" rel="noopener noreferrer">official page</a></li>)}
    </ul>

    <h2>Freely licensed photos (Wikimedia Commons)</h2>
    <ul>
      {free.map((c) => (
        <li><b>{name(c.id)}</b> — “{c.title}” by {c.author}, <a href={c.licenseUrl || c.source} target="_blank" rel="noopener noreferrer">{c.license}</a>, <a href={c.source} target="_blank" rel="noopener noreferrer">source</a></li>
      ))}
    </ul>
  </div>
</Base>
