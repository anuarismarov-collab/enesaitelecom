---
import Base from '../../layouts/Base.astro';
import Listing from '../../components/Listing.astro';
import { brands, products, slugify } from '../../lib/data';
export function getStaticPaths() { return brands.map((b) => ({ params: { slug: slugify(b) }, props: { brand: b } })); }
const { brand } = Astro.props;
const items = products.filter((p) => p.brand === brand);
---
<Base title={`${brand} products`} description={`Original ${brand} products with warranty. Retail and wholesale prices, delivery across the UAE.`}>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/shop/">Shop</a> / <span>{brand}</span></nav>
    <div class="page-head"><h1>{brand}</h1></div>
    <Listing items={items} />
  </div>
</Base>
