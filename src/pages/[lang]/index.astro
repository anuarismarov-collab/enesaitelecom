---
import Base from '../../layouts/Base.astro';
import Art from '../../components/Art.astro';
import LeadForm from '../../components/LeadForm.astro';
import WorldMap from '../../components/WorldMap.astro';
import BrandShowcase from '../../components/BrandShowcase.astro';
import WhySection from '../../components/WhySection.astro';
import { langPaths } from '../../lib/paths';
import { useT, lp } from '../../i18n/dict';
import { categories, productsOf, imageOf, site } from '../../lib/data';
export const getStaticPaths = langPaths;

const { lang } = Astro.params as { lang: string };
const T = useT(lang), H = T.home, HE = H.hero;
---
<Base lang={lang} title={`${site.name} — ${HE.tagline}`} description={HE.lead}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-copy">
        <span class="tag">{H.badge}</span>
        <h1><span class="h1-name">{HE.h1}</span><span class="grad">{HE.tagline}</span></h1>
        <p class="lead">{HE.lead}</p>
        <div class="hero-btns">
          <a href={lp(lang, '/partnership/')} class="btn lg">{HE.cta1} <span aria-hidden="true">↗</span></a>
          <a href={lp(lang, '/products/')} class="btn lg ghost">{HE.cta2}</a>
        </div>
        <ul class="chips">{H.chips.map((c) => <li>{c}</li>)}</ul>
      </div>
      <div class="hero-stage" data-tilt>
        <div class="duo-tilt">
          <img class="duo" src="/brand/iphone-18-pro-duo.webp" width="900" height="1260" alt={HE.stageAlt} decoding="async" fetchpriority="high" />
        </div>
        <span class="stage-shine" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap stats-in">{H.stats.map((s) => <div class="stat"><b>{s.v}</b><span>{s.l}</span></div>)}</div>
  </section>

  <section class="sec wrap intro-grid">
    <div><span class="eyebrow">{H.about.eyebrow}</span><h2>{H.about.title}</h2></div>
    <div><p class="intro-text">{H.about.text}</p><a class="btn ghost" href={lp(lang, '/about/')}>{H.about.cta}</a></div>
  </section>

  <section class="sec tight wrap">
    <div class="head"><span class="eyebrow">{H.range.eyebrow}</span><h2>{H.range.title}</h2><p class="muted">{H.range.lead}</p></div>
    <div class="ctiles">
      {categories.map((c) => {
        const img = c.rep ? imageOf(c.rep) : undefined;
        return (
          <a class="ctile" href={lp(lang, `/products/${c.id}/`)}>
            <span class="cvis">{img ? <img src={img.file} alt="" width="300" height="300" loading="lazy" decoding="async" /> : <Art art={c.art} />}</span>
            <span class="ctxt"><b>{T.cats[c.id as keyof typeof T.cats][0]}</b><small>{productsOf(c.id).length} {T.common.products} · {T.cats[c.id as keyof typeof T.cats][1]}</small></span>
          </a>
        );
      })}
    </div>
    <p class="more"><a class="btn ghost" href={lp(lang, '/products/all/')}>{T.common.viewAll}</a></p>
  </section>

  <BrandShowcase lang={lang} />

  <WhySection lang={lang} withMore />

  <section class="sec wrap geo">
    <div class="geo-copy"><span class="eyebrow">{H.geo.eyebrow}</span><h2>{H.geo.title}</h2><p class="muted">{H.geo.lead}</p>
      <a class="btn ghost" href={lp(lang, '/logistics/')}>{T.common.learnMore}</a></div>
    <WorldMap lang={lang} />
  </section>

  <section class="band">
    <div class="wrap band-in"><div><h2>{H.partner.title}</h2><p>{H.partner.text}</p></div>
      <div class="band-btns"><a class="btn lg light" href={lp(lang, '/partnership/')}>{T.common.becomePartner}</a><a class="btn lg ghost-l" href={lp(lang, '/contact/')}>{T.common.contactSales}</a></div></div>
  </section>

  <section class="sec wrap faq-sec">
    <div><span class="eyebrow">{H.faq.eyebrow}</span><h2>{H.faq.title}</h2></div>
    <div class="faq">{H.faq.items.map((it) => <details><summary>{it.q}</summary><p>{it.a}</p></details>)}</div>
  </section>

  <section class="sec tight wrap form-sec" id="price-list">
    <div class="form-card">
      <div class="form-intro"><span class="eyebrow">{H.price.eyebrow}</span><h2>{H.price.title}</h2><p class="muted">{H.price.lead}</p></div>
      <LeadForm lang={lang} kind="pricelist" />
    </div>
  </section>
</Base>
