---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import LeadForm from '../../components/LeadForm.astro';
import { langPaths } from '../../lib/paths';
import { useT } from '../../i18n/dict';
import { site, waLink } from '../../lib/data';
export const getStaticPaths = langPaths;
const { lang } = Astro.params as { lang: string };
const T = useT(lang), C = T.contact;
// Map: a Google embed that is loaded only after the visitor clicks (see app.ts).
// site.json → mapQuery decides the pin; mapUrl (optional) = a share link from Google Maps for the exact building.
const q = encodeURIComponent((site as { mapQuery?: string }).mapQuery || site.address);
const mapSrc = `https://www.google.com/maps?q=${q}&hl=${lang}&z=16&output=embed`;
const mapLink = (site as { mapUrl?: string }).mapUrl || `https://www.google.com/maps/search/?api=1&query=${q}`;
---
<Base lang={lang} title={C.title} description={`${C.lead} ${site.address}.`}>
  <PageHead lang={lang} title={C.title} lead={C.lead} />
  <section class="sec tight wrap contact-grid">
    <div>
      <ul class="cinfo">
        <li><b>{C.address}</b>{site.address}</li>
        <li><b>{C.phone}</b><a href={`tel:${site.phone.replace(/\s/g, '')}`} dir="ltr">{site.phone}</a></li>
        {site.email && <li><b>{C.email}</b><a href={`mailto:${site.email}`} dir="ltr">{site.email}</a></li>}
        <li><b>{C.hours}</b>{site.hours}</li>
        <li><b>{C.whatsapp}</b><a href={waLink(`Hello ${site.name}`)} target="_blank" rel="noopener noreferrer">{C.chat}</a></li>
        {site.telegram && <li><b>{C.telegram}</b><a href={site.telegram} target="_blank" rel="noopener noreferrer">{site.telegram.replace('https://', '')}</a></li>}
        {site.linkedin && <li><b>{C.linkedin}</b><a href={site.linkedin} target="_blank" rel="noopener noreferrer">{site.linkedin.replace('https://', '')}</a></li>}
        {site.licence && <li><b>{C.licence}</b>{site.licence}</li>}
      </ul>
      <div class="map" data-map={mapSrc} data-title={C.map}>
        <div class="mapcap"><b>{site.address}</b>
          <div class="map-actions"><button class="btn sm" type="button" data-map-load>{C.mapShow}</button><a class="btn sm ghost" href={mapLink} target="_blank" rel="noopener noreferrer">{C.mapOpen}</a></div>
          <small>{C.mapNote}</small></div>
      </div>
    </div>
    <div class="form-card">
      <div class="form-intro"><h2>{C.formTitle}</h2><p class="muted">{C.formLead}</p></div>
      <LeadForm lang={lang} kind="general" />
    </div>
  </section>
</Base>
