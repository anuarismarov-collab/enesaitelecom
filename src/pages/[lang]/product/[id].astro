---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import ProductImg from '../../../components/ProductImg.astro';
import ProductCard from '../../../components/ProductCard.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { LANGS, useT, lp } from '../../../i18n/dict';
import { products, imageOf, site, slugify, showCatalog, type Product } from '../../../lib/data';
export function getStaticPaths() { if (!showCatalog) return []; return LANGS.flatMap((lang) => products.map((p) => ({ params: { lang, id: p.id }, props: { p } }))); }
const { lang } = Astro.params as { lang: string };
const { p } = Astro.props as { p: Product };
const T = useT(lang), C = T.common;
const photo = imageOf(p.id);
const related = [...products.filter((x) => x.cat === p.cat && x.id !== p.id), ...products.filter((x) => x.cat !== p.cat)].slice(0, 4);
const catLabel = T.cats[p.cat as keyof typeof T.cats][0];
const avail: Record<string, string> = { in: 'InStock', low: 'LimitedAvailability', pre: 'PreOrder', out: 'OutOfStock' };
const ld = { '@context': 'https://schema.org', '@type': 'Product', name: p.name, description: p.desc, ...(photo ? { image: new URL(photo.file, Astro.site).href } : {}), brand: { '@type': 'Brand', name: p.brand }, sku: p.id, offers: { '@type': 'Offer', availability: `https://schema.org/${avail[p.stock]}`, itemCondition: 'https://schema.org/NewCondition', seller: { '@type': 'Organization', name: site.name } } };
---
<Base lang={lang} title={p.name} description={`${p.desc} ${C.priceOnRequest}.`} jsonLd={ld}>
  <PageHead lang={lang} title={p.name} crumbs={[[T.nav.products, lp(lang, '/products/')], [catLabel, lp(lang, `/products/${p.cat}/`)]]} />
  <section class="sec tight wrap">
    <div class="dgrid">
      <div>
        <div class:list={['dimg', { 'has-photo': !!photo }]}><ProductImg p={p} priority /></div>
        {photo && photo.kind === 'brand' && <p class="fine">Image © {photo.author}, from the manufacturer's official product page. Temporary image.</p>}
        {photo && !photo.own && photo.kind !== 'brand' && <p class="fine">Photo: {photo.author} · <a href={photo.licenseUrl || photo.source} target="_blank" rel="noopener noreferrer">{photo.license}</a> · <a href={photo.source} target="_blank" rel="noopener noreferrer">source</a>. Temporary image.</p>}
      </div>
      <div class="dinfo">
        <a class="brandline" href={lp(lang, `/brands/${slugify(p.brand)}/`)}>{p.brand}</a>
        <p class="por big">{C.priceOnRequest} · {C.moq}</p>
        <p class="ddesc">{p.desc}</p>
        <button class="btn lg" type="button" data-add={p.id}>{C.addToQuote}</button>
      </div>
    </div>
    <h2 class="sh">{C.specs}</h2>
    <table class="specs"><tbody>{Object.entries(p.specs).filter(([k]) => k !== 'Condition').map(([k, v]) => <tr><th scope="row">{k}</th><td><bdi>{v}</bdi></td></tr>)}</tbody></table>
    <div class="form-card inquiry">
      <div class="form-intro"><h2>{T.products.productForm}</h2><p class="muted">{T.products.productFormLead}</p></div>
      <LeadForm lang={lang} kind="product" productId={p.id} productName={p.name} />
    </div>
    <h2 class="sh">{C.related}</h2>
    <div class="pgrid">{related.map((x) => <ProductCard p={x} lang={lang} />)}</div>
  </section>
</Base>
