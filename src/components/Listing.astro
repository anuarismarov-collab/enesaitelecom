---
// Product grid + filter sidebar. Cards are rendered at build time (good for SEO); filtering/sorting is progressive JS.
import ProductCard from './ProductCard.astro';
import { categories, type Product } from '../lib/data';
import { useT, lp } from '../i18n/dict';
interface Props { items: Product[]; lang: string; activeCat?: string }
const { items, lang, activeCat = '' } = Astro.props;
const T = useT(lang), C = T.common;
const brandList = [...new Set(items.map((p) => p.brand))].sort((a, b) => a.localeCompare(b));
---
<div class="shop-tools">
  <button class="btn ghost sm" type="button" id="fToggle" aria-expanded="false" aria-controls="filters">{C.filters}</button>
  <label class="sortl">{C.sort}
    <select id="sort"><option value="featured">{C.featured}</option><option value="name">{C.nameAZ}</option></select>
  </label>
</div>
<div class="shop-in" data-listing>
  <aside class="filters" id="filters" aria-label={C.filters}>
    <div class="fgrp"><h4>{C.category}</h4>
      <a class:list={['rad', { on: !activeCat }]} href={lp(lang, '/products/all/')}>{T.products.all}</a>
      {categories.map((c) => <a class:list={['rad', { on: activeCat === c.id }]} href={lp(lang, `/products/${c.id}/`)}>{T.cats[c.id as keyof typeof T.cats][0]}</a>)}
    </div>
    <div class="fgrp"><h4>{C.brand}</h4>
      {brandList.map((b) => <label class="rad"><input type="checkbox" name="brand" value={b} /> {b}</label>)}
    </div>
    <button class="btn ghost block" id="reset" type="button">{C.reset}</button>
  </aside>
  <div>
    <p class="muted" id="count" aria-live="polite">{items.length} {C.products}</p>
    <div class="pgrid" data-grid>{items.map((p) => <ProductCard p={p} lang={lang} />)}</div>
    <p class="empty big" data-empty hidden>{C.noMatch}</p>
  </div>
</div>
