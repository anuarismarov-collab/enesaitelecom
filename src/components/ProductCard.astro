---
import ProductImg from './ProductImg.astro';
import { imageOf, type Product } from '../lib/data';
import { useT, lp } from '../i18n/dict';
interface Props { p: Product; lang: string }
const { p, lang } = Astro.props;
const T = useT(lang);
const href = lp(lang, `/product/${p.id}/`);
const catLabel = T.cats[p.cat as keyof typeof T.cats]?.[0] ?? p.cat;
---
<article class="pcard" data-brand={p.brand} data-stock={p.stock} data-feat={p.featured ? 1 : 0} data-name={p.name} data-search={`${p.name} ${p.brand} ${catLabel}`.toLowerCase()}>
  {p.badge && <span class="pbadge">{p.badge}</span>}
  <a href={href} class:list={['pimg', { 'has-photo': !!imageOf(p.id) }]} aria-label={p.name} tabindex="-1"><ProductImg p={p} /></a>
  <div class="pbody">
    <small>{p.brand} · {catLabel}</small>
    <h3><a href={href}>{p.name}</a></h3>
    <div class="prow"><span class={`pill ${p.stock}`}>{T.stock[p.stock]}</span><span class="por">{T.common.priceOnRequest}</span></div>
    <button class="btn block" type="button" data-add={p.id}>{T.common.addToQuote}</button>
  </div>
</article>
