---
// Simple product drawings used until real photos are supplied.
// Classes: .t = tone colour fill, .k = solid ink fill, .n = no fill (lines only). Everything else is white with ink outline.
interface Props { art: string; label?: string }
const { art, label = '' } = Astro.props;
---
<svg class="art" viewBox="0 0 200 160" role="img" aria-label={label} focusable="false">
  <circle class="t halo" cx="100" cy="84" r="64" />
  {art === 'console' && (<>
    <rect x="62" y="16" width="76" height="128" rx="14" /><path class="t" d="M120 16h6a12 12 0 0 1 12 12v104a12 12 0 0 1-12 12h-6z" />
    <rect class="k" x="74" y="40" width="30" height="5" rx="2.5" /><circle class="k" cx="89" cy="124" r="5" />
  </>)}
  {art === 'controller' && (<>
    <path d="M52 62h96c14 0 24 10 28 28l6 34c2 12-8 18-16 12l-18-18H72l-18 18c-8 6-18 0-16-12l6-34c4-18 14-28 28-28z" />
    <circle class="t" cx="72" cy="86" r="9" /><circle class="t" cx="128" cy="98" r="9" /><path class="n" d="M142 78v8M138 82h8M66 100v10M61 105h10" />
  </>)}
  {art === 'laptop' && (<>
    <rect x="44" y="26" width="112" height="76" rx="7" /><rect class="t" x="52" y="34" width="96" height="60" rx="3" />
    <path d="M24 108h152l-10 18H34z" /><path class="n" d="M88 116h24" />
  </>)}
  {art === 'phone' && (<>
    <rect x="70" y="12" width="60" height="136" rx="14" /><rect class="t" x="77" y="24" width="46" height="112" rx="8" />
    <circle class="k" cx="88" cy="36" r="4" /><circle class="k" cx="100" cy="36" r="4" />
  </>)}
  {art === 'tablet' && (<>
    <rect x="44" y="20" width="112" height="124" rx="12" /><rect class="t" x="53" y="30" width="94" height="104" rx="5" /><circle class="k" cx="100" cy="25" r="2.5" />
  </>)}
  {art === 'vacuum' && (<>
    <rect class="t" x="82" y="14" width="40" height="48" rx="12" /><rect x="98" y="62" width="8" height="62" /><rect x="66" y="124" width="72" height="16" rx="8" /><circle cx="102" cy="38" r="8" />
  </>)}
  {art === 'dryer' && (<>
    <circle class="t" cx="100" cy="62" r="40" /><circle cx="100" cy="62" r="15" /><rect x="90" y="100" width="20" height="52" rx="10" />
  </>)}
  {art === 'headset' && (<>
    <path class="n" d="M46 96a54 54 0 0 1 108 0" /><rect class="t" x="34" y="88" width="30" height="52" rx="14" /><rect class="t" x="136" y="88" width="30" height="52" rx="14" />
  </>)}
  {art === 'earbuds' && (<>
    <rect x="58" y="70" width="84" height="64" rx="22" /><path class="n" d="M58 96h84" /><circle class="k" cx="100" cy="112" r="4" />
    <rect class="t" x="66" y="22" width="18" height="52" rx="9" /><rect class="t" x="116" y="22" width="18" height="52" rx="9" />
  </>)}
  {art === 'watch' && (<>
    <rect x="80" y="10" width="40" height="30" rx="6" /><rect x="80" y="120" width="40" height="30" rx="6" />
    <rect x="62" y="36" width="76" height="88" rx="22" /><rect class="t" x="70" y="44" width="60" height="72" rx="14" /><path class="n" d="M100 62v18l12 8" />
  </>)}
  {art === 'camera' && (<>
    <rect x="42" y="44" width="116" height="80" rx="14" /><rect class="t" x="60" y="52" width="40" height="64" rx="10" />
    <circle class="k" cx="130" cy="84" r="16" /><circle cx="130" cy="84" r="8" /><rect x="52" y="34" width="24" height="12" rx="4" />
  </>)}
  {art === 'drone' && (<>
    <path class="n" d="M52 56l30 22M148 56l-30 22M52 112l30-22M148 112l-30-22" /><rect class="t" x="78" y="66" width="44" height="40" rx="12" />
    <circle cx="48" cy="52" r="14" /><circle cx="152" cy="52" r="14" /><circle cx="48" cy="116" r="14" /><circle cx="152" cy="116" r="14" /><circle class="k" cx="100" cy="86" r="7" />
  </>)}
  {art === 'printer' && (<>
    <rect x="62" y="16" width="76" height="44" rx="4" /><rect x="36" y="56" width="128" height="62" rx="12" /><rect class="t" x="58" y="96" width="84" height="48" rx="4" />
    <circle class="k" cx="148" cy="72" r="4" /><path class="n" d="M70 112h60" />
  </>)}
  {art === 'mouse' && (<>
    <rect x="64" y="22" width="72" height="116" rx="34" /><path class="n" d="M100 22v44M64 66h72" /><rect class="t" x="94" y="36" width="12" height="22" rx="6" />
  </>)}
  {art === 'plug' && (<>
    <rect x="62" y="40" width="76" height="76" rx="14" /><rect class="k" x="82" y="18" width="8" height="22" rx="2" /><rect class="k" x="110" y="18" width="8" height="22" rx="2" />
    <rect class="t" x="84" y="116" width="32" height="30" rx="8" /><circle class="k" cx="100" cy="78" r="6" />
  </>)}
</svg>
