---
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/manrope';
import '@fontsource-variable/cairo';
import '../styles/global.css';
import { site, products, categories, waLink } from '../lib/data';
import { LANGS, DICT, useT, lp } from '../i18n/dict';

interface Props { lang: string; title: string; description: string; jsonLd?: object; noindex?: boolean }
const { lang, title, description, jsonLd, noindex = false } = Astro.props;
const T = useT(lang);
const origin = Astro.site!.origin;
const pathname = Astro.url.pathname;
const rest = pathname.replace(/^\/(en|ru|ar)(?=\/|$)/, '') || '/';          // path without language prefix
const canonical = origin + lp(lang, rest);
const fullTitle = title.includes('Enesai') || title.includes('ENESAI') ? title : `${title} | Enesai Telecom`;
const org = { '@context': 'https://schema.org', '@type': 'Organization', name: site.name, url: origin, logo: origin + '/brand/logo-full.webp', foundingDate: String(site.founded), address: { '@type': 'PostalAddress', streetAddress: 'First Floor, 5 East B, Dubai Airport Free Zone', addressLocality: 'Dubai', addressCountry: 'AE' }, email: site.email, telephone: site.phone };
// JSON blocks are data, not code — allowed under the strict CSP. "<" is escaped so data can never close the tag.
const safeJson = (o: unknown) => JSON.stringify(o).replace(/</g, '\\u003c');
const catalog = Object.fromEntries(products.map((p) => [p.id, p.name]));
const nav: [string, string][] = [['/', T.nav.home], ['/about/', T.nav.about], ['/products/', T.nav.products], ['/partnership/', T.nav.partnership], ['/logistics/', T.nav.logistics], ['/contact/', T.nav.contact]];
const isActive = (p: string) => (p === '/' ? rest === '/' : rest.startsWith(p));
const ui = { lang, f: T.f, cookie: T.cookie, name: site.name, whatsapp: site.whatsapp, ga4: site.ga4, catalog, empty: T.f.quoteEmpty, shown: T.common.products, noMatch: T.common.noMatch };
---
<!doctype html>
<html lang={T.htmlLang} dir={T.dir}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l} href={origin + lp(l, rest)} />)}
  <link rel="alternate" hreflang="x-default" href={origin + lp('en', rest)} />
  <link rel="icon" href="/brand/favicon.png" type="image/png" />
  <link rel="apple-touch-icon" href="/brand/apple-touch-icon.png" />
  <meta name="theme-color" content="#0b1226" />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:image" content={origin + '/brand/logo-full.webp'} />
  <meta name="twitter:card" content="summary" />
  <script type="application/ld+json" set:html={safeJson(org)} />
  {jsonLd && <script type="application/ld+json" set:html={safeJson(jsonLd)} />}
</head>
<body class={`lang-${lang}`}>
  <a class="skip" href="#main">{T.nav.skip}</a>
  <div class="topbar">{T.common.sampleBar}</div>
  <header class="nav">
    <div class="wrap nav-in">
      <a href={lp(lang)} class="brand" aria-label={site.name}>
        <img src="/brand/logo-mark.webp" width="38" height="38" alt="" />
        <span class="brand-t"><b>ENESAI</b><small>TELECOM FZCO</small></span>
      </a>
      <nav class="links" id="links" aria-label="Main">
        {nav.map(([p, label]) => <a href={lp(lang, p)} aria-current={isActive(p) ? 'page' : undefined}>{label}</a>)}
        <div class="menu-extra">
          <div class="langs" role="group" aria-label={T.nav.language}>
            {LANGS.map((l) => <a href={lp(l, rest)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{DICT[l].langName}</a>)}
          </div>
          <a class="btn" href={lp(lang, '/products/#price-list')}>{T.nav.cta}</a>
        </div>
      </nav>
      <div class="langs langs-d" role="group" aria-label={T.nav.language}>
        {LANGS.map((l) => <a href={lp(l, rest)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{DICT[l].short}</a>)}
      </div>
      <button class="btn sm quote-btn" type="button" data-open aria-label={T.nav.quote}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01"/></svg><span class="qlabel">{T.nav.quote}</span> <b id="cartCount">0</b></button>
      <a class="btn sm cta-nav" href={lp(lang, '/products/#price-list')}>{T.nav.cta}</a>
      <button class="burger" id="burger" type="button" aria-label={T.nav.menu} aria-expanded="false" aria-controls="links"><span></span><span></span></button>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="foot">
    <div class="wrap foot-in">
      <div class="foot-brand">
        <img src="/brand/logo-full-white.webp" width="180" height="143" alt={site.name} loading="lazy" />
        <p>{T.footer.about}</p>
      </div>
      <div><h4>{T.footer.company}</h4>
        <a href={lp(lang, '/about/')}>{T.nav.about}</a><a href={lp(lang, '/partnership/')}>{T.nav.partnership}</a><a href={lp(lang, '/logistics/')}>{T.nav.logistics}</a><a href={lp(lang, '/contact/')}>{T.nav.contact}</a></div>
      <div><h4>{T.footer.products}</h4>{categories.slice(0, 5).map((c) => <a href={lp(lang, `/products/${c.id}/`)}>{T.cats[c.id as keyof typeof T.cats][0]}</a>)}</div>
      <div><h4>{T.footer.legal}</h4><a href={lp(lang, '/privacy/')}>{T.footer.privacy}</a><a href={lp(lang, '/terms/')}>{T.footer.terms}</a><a href={lp(lang, '/credits/')}>{T.common.images}</a>
        <p class="fine-w">{site.licence}</p></div>
      <div><h4>{T.footer.contact}</h4>
        <a href={`tel:${site.phone.replace(/\s/g, '')}`} dir="ltr">{site.phone}</a>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={waLink(`Hello ${site.name}`)} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <p class="fine-w">{site.address}</p></div>
    </div>
    <div class="wrap foot-bot"><span>© {new Date().getFullYear()} {site.name}. {T.footer.rights}</span></div>
  </footer>

  <a class="wa-float" href={waLink(`Hello ${site.name}, I would like to discuss wholesale cooperation.`)} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"/></svg>
    <span>WhatsApp</span>
  </a>

  <div class="scrim" id="scrim"></div>
  <aside class="drawer" id="drawer" aria-label={T.f.quoteTitle} aria-hidden="true">
    <div class="d-head"><h3>{T.f.quoteTitle}</h3><button class="x" type="button" data-close aria-label="Close">×</button></div>
    <div class="d-body" id="dBody"></div>
    <form class="d-foot" id="dForm" data-lead="quote" novalidate>
      <input type="text" name="name" placeholder={T.f.name} required maxlength="80" autocomplete="name" aria-label={T.f.name} />
      <input type="text" name="company" placeholder={T.f.company} required maxlength="120" autocomplete="organization" aria-label={T.f.company} />
      <input type="text" name="country" placeholder={T.f.country} required maxlength="80" autocomplete="country-name" aria-label={T.f.country} />
      <input type="email" name="email" placeholder={T.f.email} required maxlength="120" autocomplete="email" aria-label={T.f.email} />
      <input type="tel" name="phone" placeholder={T.f.phone} maxlength="30" autocomplete="tel" aria-label={T.f.phone} />
      <label class="hp" aria-hidden="true">Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      <label class="consent"><input type="checkbox" name="consent" required /> <span>{T.f.consent} <a href={lp(lang, '/privacy/')}>{T.f.privacyLink}</a></span></label>
      <button class="btn block" type="submit">{T.f.submitQuote}</button>
      <p class="form-msg" role="status" aria-live="polite"></p>
      <p class="note">{T.f.quoteNote}</p>
    </form>
  </aside>

  <div class="cookie" id="cookie" role="dialog" aria-label="Cookies" hidden>
    <p>{T.cookie.text} <a href={lp(lang, '/privacy/')}>{T.cookie.learn}</a></p>
    <div><button class="btn sm ghost" type="button" data-cookie="no">{T.cookie.decline}</button><button class="btn sm" type="button" data-cookie="yes">{T.cookie.accept}</button></div>
  </div>

  <script type="application/json" id="site-data" set:html={safeJson(ui)} />
  <script>import '../scripts/app.ts';</script>
</body>
</html>
